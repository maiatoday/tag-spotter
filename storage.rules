rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can read and write files in their own user folder: users/{userId}/...
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public spots thumbnails: open read for community discovery, authenticated write
    match /public_spots/{uuid}/thumbnails/{imageFile} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
