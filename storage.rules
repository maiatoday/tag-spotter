rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Canonical spot thumbnails: owner-only writes; reads allowed to owner or when canonical spot is public and owned by userId
    match /spots/{userId}/{spotUuid}/thumbnails/{imageFile} {
      allow read: if (request.auth != null && request.auth.uid == userId)
                  || (firestore.get(/databases/(default)/documents/spots/$(spotUuid)).data.isPublic == true
                      && firestore.get(/databases/(default)/documents/spots/$(spotUuid)).data.ownerUid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy user private folder (retained for backward compatibility / migration)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy public spots thumbnails (read-only compatibility during migration)
    match /public_spots/{userId}/{uuid}/thumbnails/{imageFile} {
      allow read: if true;
      allow write: if false;
    }

    match /public_spots/{uuid}/thumbnails/{imageFile} {
      allow read: if true;
      allow write: if false;
    }
  }
}
