rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{userId}/{document=**}
    // Document ID: userId / subcollection document IDs
    // Purpose: Private user workspace, settings, and personal spots.
    // Access: Owner only (request.auth.uid == userId).
    //
    // Collection: shared_packs/{code}
    // Document ID: code (6-character alphanumeric pack share code)
    // Fields:
    //   - packId: string (required) - Shared pack code
    //   - title: string (required) - Pack title
    //   - authorName: string (required) - Display name of curator
    //   - description: string (required) - Pack description
    //   - spots: list (required) - List of SpotDetails in the pack
    // Access: Authenticated users can read and create/update shared packs.
    //
    // Collection: public_spots/{uuid}
    // Document ID: uuid (UUID string matching spot.uuid)
    // Fields:
    //   - spot: map (required)
    //     - uuid: string (required) - Unique spot UUID
    //     - ownerUid: string (required, immutable) - Author's Firebase Auth UID
    //     - isPublic: bool (required, must be true) - Public visibility flag
    //     - description: string (optional, max 5000 chars)
    //     - category: string (optional, max 100 chars)
    //     - status: string (optional, max 100 chars)
    //     - tags: list of strings (optional, max 100 items)
    //     - artists: list of strings (optional, max 100 items)
    //     - photographer: string (optional, max 100 chars)
    //     - artworkDate: string (optional, max 100 chars)
    //     - latitude: number (optional) - Coordinate latitude
    //     - longitude: number (optional) - Coordinate longitude
    //     - createdAt: number (optional) - Creation epoch timestamp
    //     - lastEditedAt: number (optional) - Edit epoch timestamp
    //   - images: list of maps (optional, max 100 items) - Attached spot images
    //   - notes: list of maps (optional, max 100 items) - Attached spot notes
    // Access:
    //   - Read: Open / public read access.
    //   - Create: Authenticated author only (request.auth.uid == spot.ownerUid, spot.isPublic == true).
    //   - Update: Authenticated author only, ownerUid immutable, spot.isPublic == true.
    //   - Delete: Authenticated author only (request.auth.uid == resource.data.spot.ownerUid).
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user matches the specified userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the authenticated user is the author of a spot
    function isSpotAuthor(spotOwnerUid) {
      return isAuthenticated() && request.auth.uid == spotOwnerUid;
    }

    // Domain validator for public spots (used in both create and update)
    function isValidPublicSpot(data) {
      return data.spot is map &&
             data.spot.ownerUid is string &&
             data.spot.ownerUid.size() > 0 &&
             data.spot.ownerUid.size() <= 128 &&
             data.spot.isPublic == true &&
             (!('uuid' in data.spot) || (data.spot.uuid is string && data.spot.uuid.size() <= 128)) &&
             (!('description' in data.spot) || (data.spot.description is string && data.spot.description.size() <= 5000)) &&
             (!('category' in data.spot) || (data.spot.category is string && data.spot.category.size() <= 100)) &&
             (!('status' in data.spot) || (data.spot.status is string && data.spot.status.size() <= 100)) &&
             (!('photographer' in data.spot) || (data.spot.photographer is string && data.spot.photographer.size() <= 100)) &&
             (!('artworkDate' in data.spot) || (data.spot.artworkDate is string && data.spot.artworkDate.size() <= 100)) &&
             (!('tags' in data.spot) || (data.spot.tags is list && data.spot.tags.size() <= 100)) &&
             (!('artists' in data.spot) || (data.spot.artists is list && data.spot.artists.size() <= 100)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 100)) &&
             (!('notes' in data) || (data.notes is list && data.notes.size() <= 100));
    }

    // Lock down all documents by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User data: users can only read and write their own documents
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Shared Packs: authenticated users can read and create shared spot packs
    match /shared_packs/{code} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    // Public Spots: open community discovery with author-only write controls
    match /public_spots/{uuid} {
      // Open read access for community discovery
      allow read: if true;

      // Author-only create: author UID must match authenticated UID and isPublic must be true
      allow create: if isSpotAuthor(request.resource.data.spot.ownerUid) &&
                       isValidPublicSpot(request.resource.data);

      // Author-only update: owner cannot be changed and data must remain valid public spot
      allow update: if isSpotAuthor(resource.data.spot.ownerUid) &&
                       request.resource.data.spot.ownerUid == resource.data.spot.ownerUid &&
                       isValidPublicSpot(request.resource.data);

      // Author-only delete: only author can remove the public spot
      allow delete: if isSpotAuthor(resource.data.spot.ownerUid);
    }
  }
}
