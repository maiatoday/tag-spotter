rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{userId}/{document=**}
    // Document ID: userId / subcollection document IDs
    // Purpose: Private user workspace and settings.
    // Access: Owner only (request.auth.uid == userId).
    //
    // Collection: shared_packs/{code}
    // Document ID: code (6-character alphanumeric pack share code)
    // Fields:
    //   - packId: string (required) - Shared pack code
    //   - title: string (required) - Pack title
    //   - authorName: string (required) - Display name of curator
    //   - description: string (required) - Pack description
    //   - spots: list (required) - List of SpotDetails in the pack
    // Access: Authenticated users can read and create/update shared packs.
    //
    // Collection: spots/{uuid}
    // Document ID: uuid (UUID string matching spot.uuid)
    // Purpose: Canonical collection for both private and public spots.
    // Fields:
    //   - ownerUid: string (required, 1..128 chars, immutable) - Author's Firebase Auth UID
    //   - isPublic: bool (required) - Public visibility flag
    //   - spot: map (required)
    //     - uuid: string (optional, max 128 chars) - Unique spot UUID
    //     - ownerUid: string (optional, must match top-level ownerUid if present)
    //     - isPublic: bool (optional, must match top-level isPublic if present)
    //     - description: string (optional, max 5000 chars)
    //     - category: string (optional, max 100 chars)
    //     - status: string (optional, max 100 chars)
    //     - tags: list of strings (optional, max 100 items)
    //     - artists: list of strings (optional, max 100 items)
    //     - photographer: string (optional, max 100 chars)
    //     - photographerUuid: string (optional, max 128 chars)
    //     - parentPackId: string or null (optional, max 128 chars)
    //     - artworkDate: string (optional, max 100 chars)
    //     - latitude: number (optional) - Coordinate latitude
    //     - longitude: number (optional) - Coordinate longitude
    //     - createdAt: number (optional) - Creation epoch timestamp
    //     - lastEditedAt: number (optional) - Edit epoch timestamp
    //   - images: list of maps (optional, max 100 items) - Attached spot images
    //   - notes: list of maps (optional, max 100 items) - Attached spot notes
    // Access:
    //   - Read: Public when resource.data.isPublic == true; otherwise owner-only.
    //   - Create: Authenticated owner only (request.auth.uid == ownerUid) with valid payload.
    //   - Update: Authenticated owner only, ownerUid immutable, with valid payload.
    //   - Delete: Authenticated owner only (request.auth.uid == resource.data.ownerUid).
    //
    // Retired Collection: public_spots/{uuid}
    //   Replaced by canonical /spots/{uuid}; denied by default rule below.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user matches the specified userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the authenticated user is the author of a spot
    function isSpotAuthor(spotOwnerUid) {
      return isAuthenticated() && request.auth.uid == spotOwnerUid;
    }

    // Ensure top-level ownerUid is not modified on update
    function ownerUidNotModified() {
      return request.resource.data.ownerUid == resource.data.ownerUid;
    }

    // Domain validator for canonical spots (used in both create and update)
    function isValidSpot(data) {
      return data.keys().hasAll(['ownerUid', 'isPublic', 'spot']) &&
             data.keys().hasOnly(['ownerUid', 'isPublic', 'spot', 'images', 'notes']) &&
             data.ownerUid is string &&
             data.ownerUid.size() > 0 &&
             data.ownerUid.size() <= 128 &&
             data.isPublic is bool &&
             data.spot is map &&
             (!('ownerUid' in data.spot) || data.spot.ownerUid == data.ownerUid) &&
             (!('isPublic' in data.spot) || data.spot.isPublic == data.isPublic) &&
             (!('uuid' in data.spot) || (data.spot.uuid is string && data.spot.uuid.size() <= 128)) &&
             (!('description' in data.spot) || (data.spot.description is string && data.spot.description.size() <= 5000)) &&
             (!('category' in data.spot) || (data.spot.category is string && data.spot.category.size() <= 100)) &&
             (!('status' in data.spot) || (data.spot.status is string && data.spot.status.size() <= 100)) &&
             (!('photographer' in data.spot) || (data.spot.photographer is string && data.spot.photographer.size() <= 100)) &&
             (!('photographerUuid' in data.spot) || (data.spot.photographerUuid is string && data.spot.photographerUuid.size() <= 128)) &&
             (!('parentPackId' in data.spot) || data.spot.parentPackId == null || (data.spot.parentPackId is string && data.spot.parentPackId.size() <= 128)) &&
             (!('artworkDate' in data.spot) || (data.spot.artworkDate is string && data.spot.artworkDate.size() <= 100)) &&
             (!('tags' in data.spot) || (data.spot.tags is list && data.spot.tags.size() <= 100)) &&
             (!('artists' in data.spot) || (data.spot.artists is list && data.spot.artists.size() <= 100)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 100)) &&
             (!('notes' in data) || (data.notes is list && data.notes.size() <= 100));
    }

    // Lock down all documents by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User data: users can only read and write their own documents
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Shared Packs: authenticated users can read and create shared spot packs
    match /shared_packs/{code} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    // Canonical Spots: unified private and public spots with owner-only write controls
    match /spots/{uuid} {
      // Public spots are readable by anyone; private spots are readable only by their owner
      allow read: if resource.data.isPublic == true ||
                     (isAuthenticated() && request.auth.uid == resource.data.ownerUid);

      // Owner-only create: ownerUid must match authenticated UID and payload must be valid
      allow create: if isValidSpot(request.resource.data) &&
                       isSpotAuthor(request.resource.data.ownerUid);

      // Owner-only update: ownerUid is immutable and payload must remain valid
      allow update: if isSpotAuthor(resource.data.ownerUid) &&
                       ownerUidNotModified() &&
                       isValidSpot(request.resource.data);

      // Owner-only delete: only the spot owner can remove the spot
      allow delete: if isSpotAuthor(resource.data.ownerUid);
    }

    // Retired: /public_spots/{uuid} has been replaced by /spots/{uuid} and is denied by default.
  }
}
