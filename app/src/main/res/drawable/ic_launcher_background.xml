<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Base deep charcoal background -->
    <path
        android:fillColor="#0F0F11"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Center radial neon cyan glow -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76"
                android:startX="54"
                android:startY="54">
                <item android:color="#2800F0FF" android:offset="0.0" />
                <item android:color="#0F00FF88" android:offset="0.5" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle urban neon grid lines (representing streets/structure) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M -10,20 L 120,85"
        android:strokeWidth="1.0"
        android:strokeColor="#0C00FF88" />
    <path
        android:fillColor="#00000000"
        android:pathData="M -10,50 L 120,115"
        android:strokeWidth="1.0"
        android:strokeColor="#0C00F0FF" />
    <path
        android:fillColor="#00000000"
        android:pathData="M -10,-10 L 120,55"
        android:strokeWidth="1.0"
        android:strokeColor="#0C00F0FF" />
    <path
        android:fillColor="#00000000"
        android:pathData="M 120,20 L -10,85"
        android:strokeWidth="1.0"
        android:strokeColor="#0CFF007F" />
</vector>
